# ---------- dashboard login ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
JWT_SECRET=put-a-long-random-string-here
# ENCRYPTION_KEY=          # optional Fernet key for broker tokens (derived from JWT_SECRET if empty)

# ---------- database ----------
MONGO_URI=mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=farooq_bot
ALLOW_MOCK_DB=true         # fall back to in-memory DB if Mongo is down (set false in production)

# ---------- market data: upstox | yfinance ----------
DATA_PROVIDER=yfinance
LTP_POLL_SECONDS=3

# ---------- Upstox (https://account.upstox.com/developer/apps) ----------
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/broker/upstox/callback
UPSTOX_ACCESS_TOKEN=

# ---------- Zerodha Kite (https://developers.kite.trade) ----------
# Set the redirect URL of your Kite app to: http://localhost:8000/api/broker/kite/callback
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

ENABLE_SCHEDULER=true
# Production: FRONTEND_URL = your Vercel URL (also auto-allowed in CORS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
